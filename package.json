{
	"name": "wrist-hit",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"lint:eslint": "eslint . --max-warnings=10",
		"lint:eslint:fix": "eslint . --max-warnings=10 --fix",
		"lint:prettier": "prettier --check \"**/*.{js,jsx,ts,tsx,json,css,md}\"",
		"lint:prettier:fix": "prettier --write \"**/*.{js,jsx,ts,tsx,json,css,md}\"",
		"fix": "npm run lint:eslint:fix && npm run lint:prettier:fix",
		"pre-commit": "lint-staged",
		"prepare": "husky"
	},
	"engines": {
		"node": ">=16"
	},
	"devDependencies": {
		"@commitlint/cli": "^20.5.0",
		"@commitlint/config-conventional": "^20.5.0",
		"@eslint/js": "^9.39.4",
		"eslint": "^9.39.4",
		"husky": "^9.1.7",
		"lint-staged": "^16.4.0",
		"prettier": "^3.8.1"
	}
}
